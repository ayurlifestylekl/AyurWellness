# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# Supabase — get these from: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Sanity.io — get these from: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Optional read token for fetching draft content from server components
SANITY_API_READ_TOKEN=your-sanity-read-token
# Required by scripts/seed-treatments.ts (Editor or higher permissions)
SANITY_API_WRITE_TOKEN=your-sanity-write-token

# Billplz — get these from: https://www.billplz.com/enterprise/developer
BILLPLZ_API_KEY=your-billplz-api-key
BILLPLZ_COLLECTION_ID=your-billplz-collection-id
BILLPLZ_WEBHOOK_SECRET=your-billplz-x-signature-key
BILLPLZ_PAYMENT_ORDER_COLLECTION_ID=your-billplz-payment-order-collection-id
BILLPLZ_PAYMENT_ORDER_SIGNATURE_KEY=your-billplz-payment-order-x-signature-key

# Cal.com — get these from: https://app.cal.com/settings/developer/api-keys
CALCOM_API_KEY=your-calcom-api-key
CALCOM_WEBHOOK_SECRET=your-calcom-webhook-secret

# Cal.com embed — public (safe to expose to the browser).
# Username = the Cal.com handle that owns the event types.
# Event slugs = the URL slugs of the two event types used by the site.
NEXT_PUBLIC_CAL_USERNAME=ayurvediclifestylekl
NEXT_PUBLIC_CAL_CONSULTATION_EVENT=free-consultation
NEXT_PUBLIC_CAL_TREATMENT_EVENT=treatment-booking

# Email (SMTP) — provider-agnostic. Works with Brevo / Mailjet / Amazon SES /
# Gmail / your domain host. Recommended: Brevo free tier (9,000 emails/month).
#   Brevo: https://app.brevo.com → SMTP & API → SMTP
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<smtp key>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
# SMTP_SECURE=true        # only for port 465 (SSL)
# Sender address customers see. Use your verified domain.
EMAIL_FROM=Ayurvedic Wellness Centre <noreply@ayurvedicwellness.com.my>

# Google OAuth — configured in BOTH places:
#   1. Google Cloud Console: https://console.cloud.google.com/apis/credentials
#      Create OAuth 2.0 Client ID → Web application.
#      Authorized redirect URI: https://<your-supabase-project>.supabase.co/auth/v1/callback
#   2. Supabase dashboard → Authentication → Providers → Google
#      Paste the Client ID + Client Secret there. Supabase handles the handshake.
# These env entries are documentation only — the app doesn't read them at runtime.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Google sign-in button — defaults to ON.
# Set to "false" to hide the "Continue with Google" button if you haven't
# configured the Google provider in Supabase yet. Hide it to keep the
# login page clean instead of showing a button that returns an error.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── DEV-ONLY: skip email OTP at sign-in ─────────────────────────────
# Set to "false" in local dev to bypass the 6-digit email OTP step and
# sign in straight to the dashboard. Useful to avoid Supabase's free-tier
# email rate limit (2/hour) while iterating.
#
# SAFETY: LoginForm hard-codes OTP_REQUIRED=true whenever NODE_ENV is
# 'production', regardless of this env var. Setting this to "false" on
# Vercel production has NO effect — production builds always require OTP.
# The flag is dev-only by compile-time enforcement, not just documentation.
#
# When this is "false", ALSO toggle OFF "Confirm email" in
# Supabase Dashboard → Authentication → Providers → Email. Otherwise
# sign-up still tries to email a confirmation code and hits the rate limit.
#
# When reverting to OTP-on dev/staging:
#   1. Set NEXT_PUBLIC_REQUIRE_OTP=true (or delete this line)
#   2. Re-enable "Confirm email" in Supabase
#   3. Delete or batch-confirm any dev accounts created with confirmation off:
#        UPDATE auth.users SET email_confirmed_at = now() WHERE email_confirmed_at IS NULL;
#   4. Restart dev server
NEXT_PUBLIC_REQUIRE_OTP=true

# Apple Sign-In — feature flag (set to "true" to render the Apple button).
# Requires an Apple Developer account ($99/yr) and Supabase Auth → Providers
# → Apple to be configured (Service ID + Team ID + Key ID + .p8 contents).
# When flag is "false" or unset, the page renders cleanly without the button.
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Phone (SMS OTP) sign-in — feature flag.
# When "false" or unset, the [Email | Phone (SMS)] toggle is hidden and
# customers sign in with email/password or Google only. Phone number is
# still collected at sign-up as a contact field (WhatsApp / order updates).
#
# To enable: set to "true" AND configure a paid SMS provider (Twilio /
# MessageBird / Vonage) in Supabase Dashboard → Auth → Providers → Phone.
# Cost: ~RM 0.20 per SMS. Set a daily spend cap in your provider's console
# to protect against bot abuse.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# Twilio (Phone OTP) — only needed if NEXT_PUBLIC_PHONE_AUTH_ENABLED=true.
# Configured in Supabase Dashboard, not in app env.
# These commented entries are for your reference only; the app never reads them.
# Configure in Supabase Dashboard → Auth → Providers → Phone → Twilio:
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=...

# Apple Sign-In credentials (for reference; configured in Supabase Dashboard):
# APPLE_SERVICE_ID=...
# APPLE_TEAM_ID=...
# APPLE_KEY_ID=...
# APPLE_PRIVATE_KEY=...    (the .p8 file contents)

# Shared secret for scheduled/cron endpoints (expire-bookings, appointment-reminders,
# health). Sent as `Authorization: Bearer <value>` (Vercel Cron) or `?key=<value>`
# (UptimeRobot free plan, which can't send custom headers). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret
